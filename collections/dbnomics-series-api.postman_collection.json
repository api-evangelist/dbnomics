          "name": "Retrieve series by IDs",
          "request": {
            "name": "Retrieve series by IDs",
            "description": {
              "content": "Responds with a list of series found by IDs, belonging potentially to different providers and datasets. A series ID is formatted like provider_code/dataset_code/series_code.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "series"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "series_ids",
                  "value": "<string>,<string>",
                  "description": "(Required) List of series IDs separated by commas. A series ID is formatted like provider_code/dataset_code/series_code."
                },
                {
                  "disabled": false,
                  "key": "facets",
                  "value": "false",
                  "description": "Return facets in the response."
                },
                {
                  "disabled": false,
                  "key": "observations",
                  "value": "false",
                  "description": "Return observations (periods and values) for each series in the response."
                },
                {
                  "disabled": false,
                  "key": "metadata",
                  "value": "true",
                  "description": "Return providers and datasets metadata in the response."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Format of the output. If using csv and the response includes series of different frequencies, many CSV files are produced."
                },
                {
                  "disabled": false,
                  "key": "align_periods",
                  "value": "false",
                  "description": "Ensure that all the periods of each series are defined in every other series, adding NA (not available) values where needed."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "The number of items to return."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "The number of items to skip before starting to collect the result set."
